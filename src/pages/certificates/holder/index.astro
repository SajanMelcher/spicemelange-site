---
import { CERT_TERMS_VERSION } from '../../../data/cert-terms';
// Spice Certificates holder page: TESTNET PREVIEW. Linked from /certificates/. Holder data (statements, links, withdrawal,
// wallet, trade) answers only on the testnet preview (SPICE_CERT_PREVIEW=1); production shows sign-in only (gate 2). Sample data only. All holder data comes from /api/certificates/* behind a wallet signature or a view-only link.
import Base from '../../../layouts/Base.astro';
import Disclaimer from '../../../components/Disclaimer.astro';
import CertFooterHook from '../../../components/CertFooterHook.astro';
import { PAYOUT_PRICING, WITHDRAW_STEPS, WITHDRAW_BOX, RATE_IN_PRACTICE } from '../../../data/certificates';
import { CERT_TARGET_AT_BUILD } from '../../../../store-core/spice-cert-net.js';
const TEST = CERT_TARGET_AT_BUILD?.testnet !== false;
---
<Base title={TEST ? 'Spice Certificate holders (TESTNET PREVIEW)' : 'Spice Certificate holders'} description={TEST ? 'Testnet preview of the Spice Certificate holder page. Sample data only.' : 'Spice Certificate holder page: sign in with the Sui wallet that holds your certificates.'} noindex>
  <section class="container-x pt-12 pb-2">
    {TEST ? <p class="eyebrow mb-3" data-testnet-label>TESTNET PREVIEW · sample data · not a real certificate</p> : <p class="eyebrow mb-3">Spice Certificates · holders</p>}
    <h1 class="text-4xl leading-tight text-sand-50 sm:text-5xl">Spice Certificate holders</h1>
    <p class="mt-3 max-w-3xl text-sand-200/90">Only you see your own certificates: sign a short message with the Sui wallet that holds them (no gas, no transaction, never your seed phrase), or open the personal view-only link we sent you. Buying certificates: see <a class="text-ibad-300" href="/certificates/">Spice Certificates</a>.</p>
  </section>

  <section class="container-x py-3" aria-label="Read this first">
    <div class="card text-sm text-sand-200" data-disclosure>
      <h2 class="font-serif text-2xl text-sand-50">Read this first</h2>
      <ul class="mt-2 list-disc space-y-1 pl-5">
        <li><b>This is not a bank deposit.</b> It is not a savings account and we are not a bank. <b>It is not insured</b> (not FDIC, not SIPC, no insurer). <b>It is not registered</b> with the SEC or any state regulator.</li>
        <li><b>Your money is invested, not set aside:</b> 38% USDC reserve on Sui, 62% STRC on a third-party platform. About $19 per certificate is kept for withdrawals.</li>
        <li><b>Neither your $100 nor the 8% is assured.</b> The 8% APR in sats is a <b>target</b>, rounded down daily ({RATE_IN_PRACTICE}) Payment depends on our ability to pay; <b>you could lose some or all of your money.</b></li>
        <li><b>Not available on demand.</b> {WITHDRAW_BOX} We aim to pay within 6 hours of a verified request: a <b>target, not a promise</b>.</li>
        <li>If you choose BTC, you take the BTC price risk. Certificates are non-transferable. Taxes are yours. No investment, tax or legal advice.</li>
      </ul>
      <p class="mt-2 text-xs muted">Terms: <a class="text-ibad-300" href="/certificates/terms/" data-cert-terms-link>Spice Certificate terms</a> (version {CERT_TERMS_VERSION}). Sats accrue as floor(100 × 0.08 / 365 / BTC price × 100,000,000) per certificate per day, using the 4 PM PT price; our ledger is the official record and updates once a day.</p>
    </div>
  </section>

  <section class="container-x py-3" aria-label="Sign in">
    <div class="card flex flex-col gap-3 sm:flex-row sm:items-center" data-signin-card>
      <button type="button" class="btn-primary" data-signin>Sign in with your Sui wallet</button>
      <p class="text-sm text-sand-200" role="status" aria-live="polite" data-msg>Your statement is shown only after your wallet signature (or your private link). Seal encryption is not used on this preview.</p>
    </div>
  </section>

  <section class="container-x hidden py-3" data-view>
    <article class="card"><h2 class="font-serif text-2xl text-sand-50">Your certificates</h2><div class="mt-2" data-summary></div><div class="tbl-wrap mt-3" data-certs></div></article>

    <article class="card mt-6" data-withdraw-card>
      <h2 class="font-serif text-2xl text-sand-50">How to withdraw</h2>
      <p class="mt-2 text-sm text-sand-200" data-withdraw-steps>{WITHDRAW_STEPS}</p>
      <p class="mt-2 text-sm text-sand-200">Whole certificates only. Choose <b>USDC on Sui</b> or <b>BTC</b>. <b data-payout-pricing>{PAYOUT_PRICING}</b></p>
      <form class="mt-3 grid gap-3 sm:grid-cols-4" data-wd-form>
        <label class="text-sm">Certificate <select class="input" data-wd-serial></select></label>
        <label class="text-sm">Payout <select class="input" data-wd-asset><option value="USDC">USDC on Sui</option><option value="BTC">BTC</option></select></label>
        <label class="text-sm sm:col-span-2">Payout address <input class="input font-mono" data-wd-addr autocomplete="off" spellcheck="false" placeholder="0x… or bc1…" /></label>
        <button class="btn-ghost sm:col-span-4" type="button" data-rd-btn>1. Send on-chain redemption request (wallet signs; dry-run first)</button>
        <button class="btn-primary sm:col-span-4" type="submit" data-wd-btn>{TEST ? '2. Sign withdrawal request (testnet preview: nothing is paid)' : '2. Sign withdrawal request'}</button>
      </form>
      <p class="mt-2 text-xs muted" data-wd-msg>View-only links can't request a withdrawal; sign in with your wallet first.</p>
    </article>

    {TEST && (<>
    <article class="card mt-6 hidden" data-wallet-card>
      <h2 class="font-serif text-2xl text-sand-50">Wallet (your own, read-only)</h2>
      <p class="mt-1 text-xs muted">Your connected wallet's balances on Sui testnet, read from public Sui GraphQL. No desk data.</p>
      <div class="tbl-wrap mt-3" data-wallet></div>
    </article>

    <article class="card mt-6 hidden" data-trade-card>
      <h2 class="font-serif text-2xl text-sand-50">Trade (your own wallet, DeepBook v3 testnet)</h2>
      <p class="mt-1 text-sm text-sand-200">Education and self-directed only, not advice. This is <b>your own trade</b>: we build the transaction, your wallet shows it and signs it, and the coins move only between your wallet and the DeepBook pool. This trade panel never touches your certificate money or your keys; coins move only between your wallet and the DeepBook pool. Testnet tokens have no value; most testnet pools have little or no liquidity.</p>
      <form class="mt-3 grid gap-3 sm:grid-cols-5" data-tr-form>
        <label class="text-sm">Side <select class="input" data-tr-side><option value="buy">Buy (pay DBUSDC)</option><option value="sell">Sell (receive DBUSDC)</option></select></label>
        <label class="text-sm">Token <select class="input" data-tr-pair><option value="SUI_DBUSDC">SUI</option><option value="WAL_DBUSDC">WAL</option><option value="DEEP_DBUSDC">DEEP</option><option value="DBTC_DBUSDC">DBTC</option></select></label>
        <label class="text-sm">Amount <input class="input" data-tr-amt inputmode="decimal" value="1" /></label>
        <label class="text-sm">Slippage limit % <input class="input" data-tr-slip inputmode="decimal" value="1" /></label>
        <button class="btn-ghost" type="submit">Quote + dry-run</button>
      </form>
      <div class="mt-3 text-sm text-sand-200" data-tr-out></div>
      <button class="btn-primary mt-3 hidden" type="button" data-tr-sign>Review and sign in my wallet</button>
      <p class="mt-2 text-xs muted">NS, IKA, XBTC and USDC pools exist on mainnet only, so they are not offered on this testnet preview.</p>
    </article>
    </>)}
  </section>

  <section class="container-x py-6"><CertFooterHook /><Disclaimer extra={(TEST ? 'TESTNET PREVIEW with sample data. ' : '') + 'Not an offer of any security or deposit. The 8% is a target, not a promise. See the Spice Certificate terms.'} /></section>

  <script>
    import { certTable, summary, walletTable, quoteBlock } from '../../../lib/holder-render.js';
    import { state, api, signIn, signMessage as sign } from '../../../lib/wallet-signin.js';
    const $ = (s) => document.querySelector(s);
    const say = (t, sel = '[data-msg]') => { $(sel).textContent = t; };
    let view = null, lastTx = null;
    function render(v) {
      view = v; $('[data-view]').classList.remove('hidden');
      $('[data-summary]').innerHTML = summary(v); $('[data-certs]').innerHTML = certTable(v);
      $('[data-wd-serial]').innerHTML = v.certificates.filter((c) => c.status === 'active' && c.withdrawal_status === 'none').map((c) => `<option value="${c.serial}">No. ${c.serial}</option>`).join('');
      $('[data-wd-btn]').disabled = !v.can_withdraw; $('[data-rd-btn]').disabled = !v.can_withdraw;
    }
    // Personal view-only link: /certificates/holder/#s=<serial>&t=<token>. The fragment never reaches a server or a log (SC15).
    const frag = new URLSearchParams(location.hash.slice(1));
    const m = /^\d{1,12}$/.test(frag.get('s') || '') && /^[A-Za-z0-9_-]{43,128}$/.test(frag.get('t') || '') ? [null, frag.get('s'), frag.get('t')] : null;
    if (location.hash === '#old-link') say('That link uses an old format we retired for your privacy. Ask reserve@thespicemelange.org for a new one.');
    if (m) history.replaceState(null, '', location.pathname); // drop the token from the address bar and history entry
    if (m) { say('Opening your view-only link…'); api('token-view', { serial: m[1], token: m[2] }).then((r) => r.ok ? (render(r.view), say('View-only link. Sign in with your wallet to request a withdrawal or see your wallet.')) : say('This link is not valid or was replaced. Ask reserve@thespicemelange.org for a new one.')); }

    $('[data-signin]').addEventListener('click', async () => {
      try {
        const r = await signIn(say); if (!r) return;
        if (!r.view) return say(document.querySelector('[data-testnet-label]') ? 'Signed in. Holder statements are a testnet preview and are not switched on here.' : 'Signed in. Holder statements are not switched on yet.');
        if (!r.view.certificates.length) return say('Signed in. This wallet holds no Spice Certificate.');
        render(r.view); say('Signed in. Session lasts 15 minutes.');
        const w = document.querySelector('[data-wallet-card]') ? await api('wallet') : { ok: false }; if (w.ok) { $('[data-wallet-card]').classList.remove('hidden'); $('[data-wallet]').innerHTML = walletTable(w); }
        document.querySelector('[data-trade-card]')?.classList.remove('hidden');
      } catch (e) { say('Wallet error: ' + (e?.message ?? e)); }
    });

    $('[data-wd-form]').addEventListener('submit', async (e) => {
      e.preventDefault(); if (!state.session) return say('Sign in with your wallet first.', '[data-wd-msg]');
      const body = { kind: 'withdraw', serial: Number($('[data-wd-serial]').value), asset: $('[data-wd-asset]').value, payoutAddress: $('[data-wd-addr]').value.trim() };
      const ch = await api('challenge', body); if (!ch.ok) return say('Refused: ' + ch.reason, '[data-wd-msg]');
      try {
        const r = await api('withdraw', { ...body, message: ch.message, signature: await sign(ch.message) });
        say(r.ok ? `Request ${r.request_id} signed. Target payout by ${r.payout_deadline_pt} (target, not a promise). ${r.note}` : 'Refused: ' + r.reason, '[data-wd-msg]');
      } catch (err) { say('Wallet error: ' + (err?.message ?? err), '[data-wd-msg]'); }
    });

    // Withdrawal step 1 (terms v2026.10.10.3): on-chain request_redemption. The server builds + dry-runs it for the signed-in
    // wallet's own certificate; only a passing dry-run goes to the wallet, which signs and executes (holder pays gas).
    $('[data-rd-btn]').addEventListener('click', async () => {
      if (!state.session) return say('Sign in with your wallet first.', '[data-wd-msg]');
      say('Building the redemption request and running a dry-run…', '[data-wd-msg]');
      const q = await api('redeem-quote', { serial: Number($('[data-wd-serial]').value), asset: $('[data-wd-asset]').value });
      if (!q.ok || !q.tx_json) return say('Not ready: ' + (q.explain ?? q.reason ?? q.dry_run?.error ?? 'dry-run failed'), '[data-wd-msg]');
      const f = state.wallet?.features?.['sui:signAndExecuteTransaction'];
      if (!f) return say('This wallet cannot sign and send transactions here.', '[data-wd-msg]');
      try {
        const r = await f.signAndExecuteTransaction({ transaction: { toJSON: async () => q.tx_json }, account: state.account, chain: q.chain });
        say(`Redemption request sent on ${q.network}: ${String(r.digest).replace(/[^A-Za-z0-9]/g, '')}. Now sign the request (step 2) and confirm by email.`, '[data-wd-msg]');
      } catch (e) { say('Not signed.', '[data-wd-msg]'); }
    });

    document.querySelector('[data-tr-form]')?.addEventListener('submit', async (e) => {
      e.preventDefault(); lastTx = null; $('[data-tr-sign]').classList.add('hidden');
      const slip = Math.round(Number($('[data-tr-slip]').value) * 100);
      if (!(slip >= 1 && slip <= 300)) return ($('[data-tr-out]').textContent = 'Slippage limit must be between 0.01% and 3%.');
      $('[data-tr-out]').textContent = 'Quoting on DeepBook testnet and running a dry-run…';
      const q = await api('trade-quote', { pair: $('[data-tr-pair]').value, side: $('[data-tr-side]').value, amount: Number($('[data-tr-amt]').value), slippageBps: slip });
      if (!q.ok) return ($('[data-tr-out]').textContent = 'Not available: ' + q.reason);
      $('[data-tr-out]').innerHTML = quoteBlock(q);
      if (q.tx_json) { lastTx = q.tx_json; $('[data-tr-sign]').classList.remove('hidden'); }
    });
    document.querySelector('[data-tr-sign]')?.addEventListener('click', async () => {
      const f = state.wallet?.features?.['sui:signAndExecuteTransaction'];
      if (!f || !lastTx) return;
      try {
        const r = await f.signAndExecuteTransaction({ transaction: { toJSON: async () => lastTx }, account: state.account, chain: 'sui:testnet' });
        $('[data-tr-out]').insertAdjacentHTML('beforeend', `<p class="mt-2">Submitted by your wallet: <span class="font-mono">${String(r.digest).replace(/[^A-Za-z0-9]/g, '')}</span> (testnet).</p>`);
      } catch (e) { $('[data-tr-out]').insertAdjacentHTML('beforeend', '<p class="mt-2">Not signed.</p>'); }
      lastTx = null; $('[data-tr-sign]').classList.add('hidden');
    });
  </script>
</Base>
