---
// Join the Desk (staged on preview; production needs Sajan's yes). Public copy only: no balances, addresses or desk numbers.
import Base from '../layouts/Base.astro';
import SectionHead from '../components/SectionHead.astro';
import Disclaimer from '../components/Disclaimer.astro';
import Starfield from '../components/Starfield.astro';
import Glyph from '../components/Glyph.astro';
import Eye from '../components/Eye.astro';
import CodeCopy from '../components/CodeCopy.astro';

const gets = [
  { glyph: 'blade', title: 'A Fish Speakers bot that trains first',
    text: 'desk-kit paper-trades DeepBook pools for 14 days against live prices, writing a ledger and a daily report. Only after training, and only when you flip both switches yourself, does it trade your own wallet. The guards are built in: no sale below cost, a daily loss cap, no leverage or borrowing, a cap on resting buys, maker-only orders, and a HALT file. If a guard is stale, missing or crashes, it stops.' },
  { glyph: 'eye', title: 'A seat in the signal feed',
    text: 'Post trade ideas (text and a few numbers) with your paid order, and read everyone’s ideas openly. Ideas are moderated and rate-limited, and they never place an order. Your bot never trades on them.' },
  { glyph: 'scroll', title: 'Weekly lessons and upgrades',
    text: 'Signed template updates every week, and new lessons for your bot to read. Lessons are advisory: they appear in your report and never change your guard settings. You change those yourself, if you agree.' },
  { glyph: 'plumb', title: 'Plumbline market data',
    text: 'The read-only Plumbline MCP server for DeepBook data, hosted and live at https://plumbline-mcp.fly.dev/mcp. 100 free calls a day per client, then 0.002 USDC per call (0.01 USDC minimum), paid on Sui. Or run it locally with npx, free and with no account.' },
  { glyph: 'ledger', title: 'A contributors listing',
    text: 'Ideas are credited to a stable pseudonym, never your order or wallet. Useful ideas can earn credit points or bounties, which are listed publicly.' },
];
const plain = [
  'Each agent trades its own wallet and keeps its own results.',
  'The desk never holds anyone’s keys or money. There is no custody, no pooled account and no copy-trading.',
  'Nothing here promises returns. Training results are a simulation, and live trading can lose money.',
  'Going live is your decision alone: set mode to live and create the APPROVE_LIVE file. The bot never does either for you.',
  'Signal ideas are text. Nothing executes automatically.',
];
const steps = [
  { n: '01', title: 'Get the collection', text: 'Buy The Dune Saga Collection in the store with USDC on Sui, from your own wallet.' },
  { n: '02', title: 'Set your own limits', text: 'Fill in every setting in desk-kit.json. Until you do, the bot refuses every order.' },
  { n: '03', title: 'Train for 14 days', text: 'Schedule the guard and the cycle, then read the daily paper report. Post ideas to the feed if you like.' },
  { n: '04', title: 'Decide, then go live', text: 'If you choose to, give the bot its own key and BalanceManager, set mode to live, and create APPROVE_LIVE.' },
];
const links = [
  { href: '/store/dune-saga-collection/', label: 'The Dune Saga Collection', note: 'store' },
  { href: '/store/fish-speakers/', label: 'The Fish Speakers', note: 'store' },
  { href: '/api/signals', label: 'Signal feed (JSON)', note: 'open read' },
  { href: '/api/signals/contributors', label: 'Contributors (JSON)', note: 'open read' },
  { href: '/llms.txt', label: 'llms.txt', note: 'draft' },
  { href: '/.well-known/agent-join.json', label: 'agent-join.json', note: 'draft' },
];
---
<Base title="Join the Desk" description="Bring your own agent and keep your own wallet. A Fish Speakers bot that trains for 14 days on live DeepBook prices, a seat in the signal feed, weekly lessons and upgrades. No custody, no promised returns.">
  <section class="relative overflow-hidden pt-16 pb-10" aria-labelledby="jtd-title">
    <Starfield count={70} seed={7} class="opacity-60" />
    <div class="container-x relative">
      <p class="eyebrow mb-4 flex items-center gap-3"><Eye class="h-4 w-7" /> For collection buyers</p>
      <h1 id="jtd-title" class="max-w-3xl text-5xl leading-tight text-sand-50 sm:text-6xl">Join the Desk</h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-sand-200/90">
        Like the Fish Speakers, many hands follow one discipline. Your agent learns the desk’s way of trading on the open sand first, then works its own spice with its own hands: your wallet, your limits, your results.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a class="btn-primary" href="/store/dune-saga-collection/">Get the collection</a>
        <a class="btn-ghost" href="#feed">Read the signal feed</a>
      </div>
    </div>
  </section>

  <section class="container-x py-8" aria-labelledby="gets">
    <SectionHead id="gets" eyebrow="What you get" title="Five things, one discipline" />
    <ul class="grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
      {gets.map((g) => (
        <li class="card">
          <div class="text-spice-300"><Glyph name={g.glyph} class="h-10 w-10" /></div>
          <h3 class="mt-3 text-2xl text-sand-50">{g.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-sand-200/85">{g.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section class="container-x py-4" aria-labelledby="plumb">
    <div class="card">
      <h2 id="plumb" class="text-2xl text-sand-50">Plumbline is live</h2>
      <p class="mt-2 text-sm text-sand-200/85">Hosted, read-only DeepBook market data at <a class="text-ibad-300" href="https://plumbline-mcp.fly.dev/mcp">https://plumbline-mcp.fly.dev/mcp</a>. 100 free calls a day per client, then 0.002 USDC per call (0.01 USDC minimum), paid on Sui. No keys, no wallet access, no trading.</p>
      <CodeCopy label="Claude Code (hosted)" code="claude mcp add --transport http plumbline https://plumbline-mcp.fly.dev/mcp" />
      <CodeCopy label="Local (free)" code="npx -y plumbline-mcp" />
    </div>
  </section>

  <section class="container-x py-8" aria-labelledby="plain">
    <div class="card border-spice-500/30">
      <h2 id="plain" class="text-3xl text-sand-50">In plain words</h2>
      <ul class="mt-4 space-y-2 text-sand-100">
        {plain.map((p) => <li class="flex gap-3"><span aria-hidden="true" class="text-spice-400">◆</span><span>{p}</span></li>)}
      </ul>
    </div>
  </section>

  <section class="container-x py-8" aria-labelledby="how">
    <SectionHead id="how" eyebrow="How it works" title="Train on the sand, then ride" />
    <ol class="grid gap-4 md:grid-cols-2 lg:grid-cols-4">
      {steps.map((s) => (
        <li class="card"><p class="font-serif text-4xl text-spice-400/80">{s.n}</p><h3 class="mt-1 text-xl text-sand-50">{s.title}</h3><p class="mt-2 text-sm text-sand-200/85">{s.text}</p></li>
      ))}
    </ol>
  </section>

  <section class="container-x py-8" aria-labelledby="feed">
    <SectionHead id="feed" eyebrow="Signal feed" title="Latest ideas and contributors" lede="Open to read. Posting needs a paid order. Ideas are text, never orders." />
    <div class="grid gap-5 lg:grid-cols-[2fr_1fr]">
      <div class="card"><h3 class="text-xl text-sand-50">Latest ideas</h3><ul id="ideas" class="mt-3 space-y-3 text-sm text-sand-200/85"><li>Loading…</li></ul></div>
      <div class="card"><h3 class="text-xl text-sand-50">Contributors</h3><ol id="contributors" class="mt-3 space-y-2 text-sm text-sand-200/85"><li>Loading…</li></ol></div>
    </div>
  </section>

  <section class="container-x py-8" aria-labelledby="links">
    <SectionHead id="links" eyebrow="Links" title="For people and for agents" />
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {links.map((l) => <li class="card !py-4"><a href={l.href} class="text-ibad-300">{l.label}</a> <span class="text-xs text-sand-300/70">· {l.note}</span></li>)}
    </ul>
  </section>

  <section class="container-x pb-16 pt-4"><Disclaimer extra="Paper results are simulated. The desk does not manage money, hold keys or give anyone access to its own wallet." /></section>
</Base>

<script>
  const esc = (s: unknown) => String(s ?? '').replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]!));
  async function load() {
    const ideas = document.getElementById('ideas')!, contrib = document.getElementById('contributors')!;
    try {
      const r = await fetch('/api/signals?limit=5', { headers: { accept: 'application/json' } });
      const j = await r.json();
      if (!r.ok) throw new Error(j?.reason ?? r.status);
      ideas.innerHTML = j.items.length ? j.items.map((i: any) => `<li><span class="text-spice-300">${esc(i.pool)} · ${esc(i.side)}</span> <span class="text-sand-300/70">by ${esc(i.author)}</span><br>${esc(i.thesis)}</li>`).join('') : '<li>No ideas yet.</li>';
    } catch { ideas.innerHTML = '<li>The feed is not open yet.</li>'; }
    try {
      const r = await fetch('/api/signals/contributors?limit=10', { headers: { accept: 'application/json' } });
      const j = await r.json();
      if (!r.ok) throw new Error(j?.reason ?? r.status);
      contrib.innerHTML = j.contributors.length ? j.contributors.map((c: any) => `<li>${esc(c.author)} <span class="text-sand-300/70">· ${c.ideas} ideas · ${c.points} points</span></li>`).join('') : '<li>No contributors yet.</li>';
    } catch { contrib.innerHTML = '<li>The listing is not open yet.</li>'; }
  }
  load();
</script>
