---
// /learn/ (Ixians R1 + R6): Hwi's free 7-lesson Golden Path course, shaped by a short quiz. DRAFT (preview only, noindex)
// until Siona's leak scan and Sajan's yes. Never asks income, savings, debts, balances or age.
import Base from '../../layouts/Base.astro';
import { COURSE, RISK, XAI_LINE } from '../../../store-core/course-content.js';
const q = [
  { k: 'track', label: 'How much have you traded before?', opts: [['pilgrim', 'New to this'], ['fremen', "I've bought some crypto"], ['naib', 'I trade actively']] },
  { k: 'goal', label: 'What would you most like from these lessons?', opts: [['longview', 'Understand the long view (why Bitcoin is "the spice")'], ['botsafety', 'Let a bot help me without losing control'], ['builder', 'Build or connect AI agents to markets'], ['evaluate', 'Judge trading bots before trusting one']] },
  { k: 'time', label: 'How much time do you have?', opts: [['brief', 'About 5 minutes a day'], ['standard', 'About 15 minutes a day'], ['weekly', 'About an hour a week']] },
  { k: 'agent', label: 'Do you use an AI agent (Grok Bot, Claude or another MCP client) today?', opts: [['yes', 'Yes'], ['no', 'Not yet']] },
];
---
<Base title="Learn the Golden Path (free course)" noindex={true} description="Hwi's free 7-lesson Golden Path course: patience, hard limits, order books and careful bots. Education only, not financial advice.">
  <section class="container-x max-w-3xl pt-16 pb-10">
    <p class="eyebrow mb-4">Free course · 7 lessons · by email or right here</p>
    <h1 class="text-4xl text-sand-50">Learn the Golden Path</h1>
    <p class="mt-4 text-sand-200/90">Seven short lessons from Hwi Noree, the desk's AI teacher: why we treat Bitcoin as a long-horizon store, the hard limits any bot should have, reading an order book, and patience at your own price. Read them below, or get them by email shaped to your answers.</p>
    <ol class="mt-6 list-decimal space-y-1 pl-6 text-sand-200/90">
      {COURSE.map((L) => <li><a class="text-ibad-300" href={`/learn/${L.n}/`}>{L.title}</a></li>)}
    </ol>
  </section>
  <section class="container-x max-w-3xl pb-16">
    <form id="fc-form" class="card space-y-5 text-sm" aria-labelledby="fc-title" hidden>
      <h2 id="fc-title" class="text-2xl text-sand-50">Get the course by email</h2>
      <p class="text-sand-200/85">Tell me a little about where you are on the sand, and I'll shape the lessons to fit. Every question is optional except your email. You can change any answer later by replying.</p>
      {q.map((x) => (
        <fieldset class="space-y-1"><legend class="font-semibold text-sand-100">{x.label}</legend>
          {x.opts.map(([v, l]) => <label class="flex items-start gap-2 text-sand-200/90"><input type="radio" name={x.k} value={v} class="mt-1" /> <span>{l}</span></label>)}
          {x.k === 'agent' && <p class="text-xs text-sand-300/70">{XAI_LINE}</p>}
        </fieldset>
      ))}
      <label class="block"><span class="font-semibold text-sand-100">Email</span><input id="fc-email" type="email" required maxlength="254" autocomplete="email" class="mt-1 w-full rounded-md border border-sand-200/20 bg-night-900 px-3 py-2" /></label>
      <label class="flex items-start gap-2 text-sand-200/90"><input id="fc-consent" type="checkbox" class="mt-1" /> <span>Send me Hwi's free 7-lesson Golden Path course. One-click unsubscribe in every email.</span></label>
      <p class="text-xs text-sand-300/75">We email you a confirmation link first; nothing else is sent until you click it. We never ask about income, savings, debts, balances or age. <a class="text-ibad-300" href="/privacy/">Privacy</a> · <a class="text-ibad-300" href="/terms/">Terms</a></p>
      <button type="submit" class="btn-primary">Send me the course</button>
      <p id="fc-msg" class="text-spice-300" role="status"></p>
    </form>
    <div class="mt-10 space-y-2 text-xs text-sand-300/75">
      <p>{RISK}</p>
      <p>These are Grok Bot templates and lessons, with no token. {XAI_LINE} Hwi Noree is an AI assistant, not a person and not a financial adviser.</p>
      <p>Dune-inspired names are an affectionate nod to Frank Herbert's novels. Not affiliated with the Herbert estate or Legendary.</p>
    </div>
  </section>
<script>
  const $ = (id: string) => document.getElementById(id) as HTMLInputElement;
  const form = document.getElementById('fc-form') as HTMLFormElement;
  fetch('/api/course/subscribe').then((x) => x.json()).then((r) => { if (r && r.open) form.hidden = false; }).catch(() => {});
  const src = (() => { try { return JSON.parse(sessionStorage.getItem('sm-src') || 'null') ?? undefined; } catch { return undefined; } })();
  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const msg = (t: string) => ($('fc-msg').textContent = t);
    if (!$('fc-consent').checked) return msg('Tick the box to get the course by email.');
    const fd = new FormData(form), body: Record<string, unknown> = { email: $('fc-email').value.trim(), consent: true, src };
    for (const k of ['track', 'goal', 'time', 'agent']) { const v = fd.get(k); if (v) body[k] = v; }
    msg('Sending…');
    const r = await fetch('/api/course/subscribe', { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) }).then((x) => x.json()).catch(() => ({ ok: false, reason: 'network_error' }));
    if (r.ok) { form.reset(); return msg('Almost done: check your inbox and click the confirm link. Nothing is sent until you do.'); }
    msg(r.reason === 'bad_email' ? 'That email does not look right.' : r.reason === 'rate_limited' ? 'Too many tries from here. Please try again in an hour.' : `Not available right now (${r.reason ?? 'error'}).`);
  });
</script>
</Base>
