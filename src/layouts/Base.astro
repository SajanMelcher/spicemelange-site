---
import '../styles/global.css';
import Sigil from '../components/Sigil.astro';
import Eye from '../components/Eye.astro';
import { SITE, NAV, DISCLAIMER, mailto } from '../data/site';
interface Props { title?: string; description?: string; noindex?: boolean; image?: string; imageAlt?: string; imageWidth?: number; imageHeight?: number }
const DEFAULT_OG_IMAGE = '/og/spice-melange-og.png';
const DEFAULT_OG_ALT = 'The Spice Melange: The Spice Must Flow. A patient bitcoin desk on the Golden Path. Amber desert dunes under a dark sky with a golden path arc.';
const { title, noindex = false, image = DEFAULT_OG_IMAGE, imageAlt = DEFAULT_OG_ALT, imageWidth = 1200, imageHeight = 630, description = 'The Spice Melange: a patient bitcoin desk on the Golden Path. Education, open tools for DeepBook on Sui, and a small team of agents.' } = Astro.props;
const fullTitle = title ? `${title} · ${SITE.name}` : `${SITE.name} · The Spice Must Flow`;
const path = Astro.url.pathname.replace(/\/?$/, '/');
const canonical = new URL(Astro.url.pathname, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;
const navPath = (h: string) => (h.startsWith('http') ? new URL(h).pathname : h);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <meta name="theme-color" content="#070914" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:image" content={ogImage} />
  <meta property="og:image:type" content="image/png" />
  <meta property="og:image:width" content={String(imageWidth)} />
  <meta property="og:image:height" content={String(imageHeight)} />
  <meta property="og:image:alt" content={imageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:site" content={SITE.xHandle} />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImage} />
  <meta name="twitter:image:alt" content={imageAlt} />
  <script is:inline>
    // Store pages only: remember utm_* / ?ref= (first touch, this tab) so checkout can save it with the order.
    (function () { try {
      if (!location.pathname.startsWith('/store')) return;
      var q = new URLSearchParams(location.search), o = {}, n = 0;
      ['utm_source','utm_medium','utm_campaign','utm_term','utm_content','ref'].forEach(function (k) { var v = q.get(k); if (v) { o[k] = v.slice(0, 64); n++; } });
      if (n && !sessionStorage.getItem('sm-src')) sessionStorage.setItem('sm-src', JSON.stringify(o));
    } catch (e) {} })();
  </script>
</head>
<body class="min-h-dvh flex flex-col">
  <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-spice-500 focus:px-4 focus:py-2 focus:text-night-950">Skip to content</a>

  <header class="sticky top-0 z-40 border-b border-sand-200/10 bg-night-950/80 backdrop-blur-md">
    <div class="container-x flex h-16 items-center justify-between gap-4">
      <a href="/" class="flex items-center gap-2.5 no-underline" aria-label="The Spice Melange, home">
        <Sigil class="h-8 w-8" />
        <span class="font-serif text-xl font-semibold text-sand-50">The Spice Melange</span>
      </a>
      <nav aria-label="Main" class="hidden md:block">
        <ul class="flex items-center gap-1 text-sm">
          {NAV.map((n) => (
            <li><a href={n.href} aria-current={path === navPath(n.href) ? 'page' : undefined}
              class={`rounded-full px-3 py-2 no-underline transition-colors ${path === navPath(n.href) ? 'bg-sand-200/10 text-sand-50' : 'text-sand-200/80 hover:text-ibad-300'}`}>{n.label}</a></li>
          ))}
          <li class="ml-2"><a href={mailto(SITE.joinSubject)} class="btn-primary !py-2">Join</a></li>
        </ul>
      </nav>
      <details class="group relative md:hidden">
        <summary class="flex min-h-11 min-w-11 cursor-pointer list-none items-center justify-center rounded-full border border-sand-200/20 [&::-webkit-details-marker]:hidden" aria-label="Open menu">
          <svg class="h-5 w-5 group-open:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          <svg class="hidden h-5 w-5 group-open:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </summary>
        <nav aria-label="Mobile" class="absolute right-0 mt-2 w-60 rounded-2xl border border-sand-200/10 bg-night-900 p-2 shadow-2xl">
          <ul class="flex flex-col">
            {NAV.map((n) => (
              <li><a href={n.href} aria-current={path === navPath(n.href) ? 'page' : undefined} class="block rounded-xl px-4 py-3 text-sand-100 no-underline hover:bg-sand-200/5">{n.label}</a></li>
            ))}
          </ul>
        </nav>
      </details>
    </div>
  </header>

  <main id="main" class="flex-1">
    <slot />
  </main>

  <footer class="mt-24 border-t border-sand-200/10 bg-night-950">
    <div class="container-x grid gap-10 py-12 md:grid-cols-[1.2fr_1fr_1fr]">
      <div>
        <a href="/" class="flex items-center gap-2.5 no-underline"><Sigil class="h-8 w-8" /><span class="font-serif text-xl text-sand-50">The Spice Melange</span></a>
        <p class="mt-3 max-w-sm text-sm text-sand-200/75">Bitcoin is the spice of the cyber economy. We hold it the patient way: no leverage, no hurry, think in decades.</p>
        <div class="mt-4 flex items-center gap-2 text-xs text-sand-300/70"><Eye class="h-5 w-8" /> <span>Blue within blue: see far, act small.</span></div>
      </div>
      <nav aria-label="Footer">
        <h2 class="mb-3 font-sans text-xs font-semibold uppercase tracking-[0.2em] text-sand-300/80">Explore</h2>
        <ul class="space-y-2 text-sm">
          {NAV.map((n) => <li><a href={n.href} class="text-sand-200/85 no-underline hover:text-ibad-300">{n.label}</a></li>)}
        </ul>
      </nav>
      <div>
        <h2 class="mb-3 font-sans text-xs font-semibold uppercase tracking-[0.2em] text-sand-300/80">Contact</h2>
        <ul class="space-y-2 text-sm">
          <li><a href={SITE.x} rel="me noopener" class="text-sand-200/85 no-underline hover:text-ibad-300">X · {SITE.xHandle}</a></li>
          <li><a href={SITE.github} rel="me noopener" class="text-sand-200/85 no-underline hover:text-ibad-300">GitHub · SajanMelcher</a></li>
          <li><a href={`mailto:${SITE.email}`} class="text-sand-200/85 no-underline hover:text-ibad-300">{SITE.email}</a></li>
          <li><a href="https://spicemelange.wal.app" rel="noopener" class="text-sand-200/85 no-underline hover:text-ibad-300">Also on Walrus · spicemelange.wal.app</a></li>
        </ul>
      </div>
    </div>
    <div class="border-t border-sand-200/10">
      <div class="container-x py-6 text-xs leading-relaxed text-sand-300/70">
        <p><strong class="text-sand-200">Disclaimer.</strong> {DISCLAIMER} The desk does not take deposits from the public. Market data on this site comes from public third-party sources and may be delayed or wrong.</p>
        <p class="mt-2">Dune-inspired names are an affectionate nod to Frank Herbert's novels. This site is independent and not affiliated with or endorsed by the Herbert estate or any film studio. All artwork is original. © {new Date().getFullYear()} Sajan Melcher.</p>
      </div>
    </div>
  </footer>

  <script>
    // Copy buttons for code snippets (progressive enhancement).
    document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((b) => {
      b.addEventListener('click', async () => {
        try { await navigator.clipboard.writeText(b.dataset.code ?? ''); b.textContent = 'Copied'; }
        catch { b.textContent = 'Select & copy'; }
        setTimeout(() => (b.textContent = 'Copy'), 1600);
      });
    });
  </script>
</body>
</html>
