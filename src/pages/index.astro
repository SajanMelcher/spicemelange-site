---
import Base from '../layouts/Base.astro';
import Starfield from '../components/Starfield.astro';
import Dunes from '../components/Dunes.astro';
import Worm from '../components/Worm.astro';
import Eye from '../components/Eye.astro';
import SectionHead from '../components/SectionHead.astro';
import Disclaimer from '../components/Disclaimer.astro';
import { SITE, mailto } from '../data/site';

const pillars = [
  { title: 'Patience', glyph: 'hourglass', text: 'The Golden Path is measured in decades, not candles. We buy on schedule, and we let time do the heavy lifting.' },
  { title: 'Accumulation', glyph: 'grain', text: 'Like the God Emperor’s hoard, the stack only grows. We add steadily, in small and boring amounts, and we sell no spice at a loss.' },
  { title: 'No leverage', glyph: 'shield', text: 'No margin, no futures, no borrowed spice on the trading desk. Leverage turns a bad week into a lost path.' },
];
const ways = [
  { href: '/join/', eyebrow: 'Learn', title: 'Walk the Golden Path', text: 'Hwi Noree’s gentle letters on bitcoin, self-custody and risk, in plain words.' },
  { href: '/plumbline/', eyebrow: 'Build', title: 'Plumbline for DeepBook', text: 'A free, read-only MCP server that lets AI agents read DeepBook market data on Sui.' },
  { href: '/dashboard/', eyebrow: 'Watch', title: 'Live DeepBook dashboard', text: 'Mid, spread, depth and volume for the main Sui pools, refreshed in your browser.' },
  { href: '/desk/', eyebrow: 'Meet', title: 'The Desk', text: 'The small council of agents that research, verify and keep the desk honest.' },
];
---
<Base>
  <!-- HERO -->
  <section class="relative isolate overflow-hidden" aria-labelledby="hero-title">
    <Starfield />
    <div class="container-x relative grid min-h-[min(88dvh,820px)] items-center gap-10 pb-48 pt-14 md:grid-cols-[1.15fr_1fr] md:pb-56">
      <div>
        <p class="eyebrow mb-4 flex items-center gap-3"><Eye class="h-4 w-7" /> A patient bitcoin desk</p>
        <h1 id="hero-title" class="text-5xl leading-[1.02] text-sand-50 sm:text-6xl lg:text-7xl">
          The spice <em class="font-serif italic text-spice-400">must</em> flow.
        </h1>
        <p class="mt-6 max-w-xl text-lg leading-relaxed text-sand-200/90">
          Bitcoin is the spice melange of the cyber economy: scarce, hard to fake, and it rewards those who see far.
          This desk hoards it the way the God Emperor kept his spice. Quietly, patiently, and without ever borrowing against tomorrow.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a class="btn-primary" href={mailto(SITE.joinSubject)}>Join the Golden Path</a>
          <a class="btn-ghost" href="/plumbline/">Explore Plumbline</a>
        </div>
        <p class="mt-4 text-xs text-sand-300/70">Education only. No returns promised. Not financial advice.</p>
      </div>
      <div class="relative mx-auto w-full max-w-md md:max-w-none">
        <Worm class="h-auto w-full drop-shadow-[0_0_40px_rgba(238,143,58,0.18)]" />
      </div>
    </div>
    <Dunes />
  </section>

  <!-- WHAT THE DESK IS -->
  <section class="container-x py-20" aria-labelledby="what">
    <div class="grid gap-10 md:grid-cols-2 md:items-start">
      <SectionHead id="what" eyebrow="What the desk is" title="A one-person desk, a small council of agents" />
      <div class="prose-desert">
        <p>The Spice Melange is Sajan Melcher’s personal bitcoin desk. It is a practice, not a fund. A handful of software agents help with the grind: they read the markets, check every number twice, draft letters and build open tools. Sajan makes every decision himself.</p>
        <p>Three things live here: plain-spoken education for family and friends, open-source tools for the Sui DeepBook ecosystem, and a public window into how a patient desk thinks.</p>
      </div>
    </div>
  </section>

  <!-- PHILOSOPHY -->
  <section class="relative border-y border-sand-200/10 bg-night-900/40 py-20" aria-labelledby="philosophy">
    <div class="container-x">
      <SectionHead id="philosophy" eyebrow="The philosophy" title="The Golden Path" lede="Spice is power because it cannot be made in a hurry. Bitcoin works the same way: a fixed supply, secured by work, that nobody can print more of. Our whole philosophy follows from that." />
      <ul class="grid gap-5 md:grid-cols-3">
        {pillars.map((p, i) => (
          <li class="card">
            <svg class="mb-4 h-10 w-10 text-spice-400" viewBox="0 0 40 40" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true">
              {p.glyph === 'hourglass' && <><path d="M12 6h16M12 34h16M14 6c0 9 12 9 12 14s-12 5-12 14M26 6c0 9-12 9-12 14s12 5 12 14"/><path d="M17 30h6" stroke="#4fb3ff"/></>}
              {p.glyph === 'grain' && <><path d="M8 30c6-5 18-5 24 0"/><path d="M11 26c5-4 13-4 18 0"/><circle cx="20" cy="15" r="5" stroke="#4fb3ff"/></>}
              {p.glyph === 'shield' && <><path d="M20 5l12 5v9c0 8-5 13-12 16C13 32 8 27 8 19v-9z"/><path d="M14 20l4 4 8-8" stroke="#4fb3ff"/></>}
            </svg>
            <p class="font-sans text-xs tracking-[0.2em] text-sand-300/70">PRINCIPLE {i + 1}</p>
            <h3 class="mt-1 text-2xl text-sand-50">{p.title}</h3>
            <p class="mt-2 text-sand-200/85">{p.text}</p>
          </li>
        ))}
      </ul>
      <blockquote class="mx-auto mt-14 max-w-3xl text-center">
        <p class="font-serif text-2xl italic leading-snug text-sand-100 sm:text-3xl">“Hold something scarce, think in decades, and never let a single vision become an all-in bet.”</p>
        <footer class="mt-3 text-sm text-sand-300/70">The desk’s rule of thumb</footer>
      </blockquote>
    </div>
  </section>

  <!-- CTAs -->
  <section class="container-x py-20" aria-labelledby="paths">
    <SectionHead id="paths" eyebrow="Choose your path" title="Four ways in" />
    <ul class="grid gap-5 sm:grid-cols-2">
      {ways.map((w) => (
        <li>
          <a href={w.href} class="card group flex h-full flex-col no-underline transition-colors hover:border-spice-400/40">
            <span class="eyebrow">{w.eyebrow}</span>
            <span class="mt-2 font-serif text-2xl text-sand-50 group-hover:text-spice-300">{w.title} <span aria-hidden="true">→</span></span>
            <span class="mt-2 text-sand-200/85">{w.text}</span>
          </a>
        </li>
      ))}
    </ul>
    <Disclaimer class="mt-10" />
  </section>
</Base>
