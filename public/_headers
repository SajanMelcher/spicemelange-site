# Site-wide security headers (HSTS, CSP with inline-script hashes, XFO, nosniff, Referrer-, Permissions-Policy) are
# prepended to dist/_headers at build time by scripts/csp-headers.mjs. /desk-sign/* adds its stricter CSP on top
# (both policies apply) and its own Referrer-Policy (no-referrer).
/templates/versions.json
  Cache-Control: public, max-age=300
/templates/versions.json.sig
  Cache-Control: public, max-age=300
  Content-Type: text/plain; charset=utf-8
/templates/release-key.pub
  Content-Type: text/plain; charset=utf-8
/rhythm.json
  Cache-Control: public, max-age=300
/rhythm.json.sig
  Cache-Control: public, max-age=300
  Content-Type: text/plain; charset=utf-8
/desk-sign/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; manifest-src 'self'; connect-src 'none'; form-action 'none'; base-uri 'none'; frame-ancestors 'none'; require-trusted-types-for 'script'
  X-Robots-Tag: noindex, nofollow, noarchive
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cache-Control: no-cache, no-transform
/og/spice-melange-og.png
  Content-Type: image/png
  Cache-Control: public, max-age=86400
  Access-Control-Allow-Origin: *
# Spice Certificates pages (sign-in, buying gate, holder page). Siona SC14: NO Referrer-Policy here, so these pages send
# exactly ONE (the site-wide strict-origin-when-cross-origin). Holder tokens live in the URL fragment (never in a referrer).
# /api/certificates/* is a Pages Function: _headers never applies there; store-core/spice-api.js json() sets its headers.
/certificates/*
  X-Robots-Tag: noindex, nofollow, noarchive
  Cache-Control: no-store
