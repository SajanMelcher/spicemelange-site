---
// Public changelog for the Grok Bot templates. Summaries only; no paid template content.
import Base from '../../../layouts/Base.astro';
import { TEMPLATES, latestFor } from '../../../../store-core/versions.js';
const all = [...TEMPLATES.templates, ...TEMPLATES.packs];
const names = Object.fromEntries(all.map((t) => [t.sku, t.name]));
const site = 'https://thespicemelange.org';
---
<Base title="Template changelog" description="Versions and release notes for The Spice Melange Grok Bot templates. Weekly updates included with every purchase.">
  <section class="container-x pt-16 pb-12" aria-labelledby="cl-title">
    <p class="eyebrow mb-4">Grok Bot templates · weekly updates included</p>
    <h1 id="cl-title" class="text-5xl leading-tight text-sand-50">Template changelog</h1>
    <p class="mt-5 max-w-2xl text-lg leading-relaxed text-sand-200/90">
      Versions are dates (YYYY.MM.DD). Current: <strong class="text-spice-300">{TEMPLATES.current}</strong>.
      Bought a template? <a class="text-ibad-300" href={`${site}/store/download/`}>Re-download the latest</a> with your order ID and token. Machine-readable: <a class="text-ibad-300" href="/templates/versions.json">versions.json</a>.
    </p>
    <div class="mt-8 overflow-x-auto">
      <table class="w-full max-w-3xl text-left text-sm text-sand-200/85">
        <thead><tr class="border-b border-sand-200/15 text-sand-50"><th class="py-2 pr-4">Template</th><th class="py-2 pr-4">Seat</th><th class="py-2">Version</th></tr></thead>
        <tbody>{all.map((t) => (
          <tr class="border-b border-sand-200/10"><td class="py-2 pr-4"><a class="text-ibad-300" href={`${site}/store/${t.sku}/`}>{t.name}</a></td><td class="py-2 pr-4">{t.title}</td><td class="py-2 font-mono">{latestFor(t.sku)?.version}</td></tr>
        ))}</tbody>
      </table>
    </div>
    <ol class="mt-10 max-w-3xl space-y-6">{TEMPLATES.releases.map((r) => (
      <li class="card">
        <h2 class="text-2xl text-sand-50"><span class="font-mono">{r.version}</span> <span class="text-sm text-sand-300/70">({r.date})</span></h2>
        <p class="mt-1 text-xs text-sand-300/70">{r.skus === 'all' ? 'All templates' : r.skus.map((s) => names[s] ?? s).join(', ')}</p>
        <p class="mt-3 text-sand-200/90">{r.summary}</p>
        {r.notes?.length > 0 && <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-sand-200/85">{r.notes.map((n) => <li>{n}</li>)}</ul>}
      </li>
    ))}</ol>
  </section>
</Base>
