---
// Shared Sui USDC checkout dialog (store index + detail pages). Buttons: .buy-btn[data-sku][data-name]
---
  <dialog id="checkout" class="m-auto w-[min(36rem,calc(100vw-2rem))] rounded-2xl border border-sand-200/15 bg-night-900 p-0 text-sand-100 backdrop:bg-night-950/80">
    <form method="dialog" class="flex items-center justify-between border-b border-sand-200/10 px-5 py-3">
      <h2 id="co-title" class="text-xl text-sand-50">Checkout</h2>
      <button class="btn-ghost !min-h-9 !px-3 !py-1" aria-label="Close">Close</button>
    </form>
    <div class="space-y-4 p-5 text-sm" aria-live="polite">
      <div id="co-step1">
        <label class="block text-sand-200/85" for="co-email">Email for your receipt (optional)</label>
        <input id="co-email" type="email" autocomplete="email" class="mt-1 w-full rounded-lg border border-sand-200/20 bg-night-950 px-3 py-2" placeholder="you@example.com" />
        <p class="mt-1 text-xs text-sand-300/70">Used only to send your receipt after review. Leave blank to stay anonymous.</p>
        <div id="co-lessons" class="mt-3" hidden>
          <label class="flex items-start gap-2 text-sand-200/85"><input id="co-lessons-opt" type="checkbox" class="mt-1" /> <span>Get Hwi's 14-day practice lessons</span></label>
          <p class="mt-1 text-xs text-sand-300/70">Optional. <span id="co-lessons-hold">The lessons are on hold until our privacy page is live, then start daily after you confirm. </span>After payment we email you a confirmation link; once you click it, you get one short email a day for the 14 days your bot trains on paper, then they stop. Uses the email above. One-click unsubscribe in every email.</p>
          <p class="mt-1 text-xs text-sand-300/80">We'll email your lessons through Resend. See our <a class="text-ibad-300" href="/privacy/">privacy page</a>.</p>
        </div>
        <button id="co-create" type="button" class="btn-primary mt-4">Get my exact amount</button>
      </div>
      <div id="co-step2" hidden>
        <p>Order <code id="co-id" class="text-spice-300"></code> on <span id="co-net"></span>. Send <strong>exactly</strong>:</p>
        <p class="flex items-center gap-2"><code id="co-amount" class="font-serif text-3xl text-spice-300"></code> <span>USDC</span> <button type="button" class="btn-ghost !min-h-8 !px-3 !py-1 co-copy" data-target="co-amount">Copy</button></p>
        <div class="rounded-xl border border-spice-500/30 bg-night-950/60 p-3">
          <button id="co-wallet" type="button" class="btn-primary">Pay with Sui wallet</button>
          <p class="mt-2 text-xs text-sand-300/80">One click: your wallet (Slush or any Sui wallet) shows the exact transfer below; you approve it there, and we check the payment automatically. We never see your keys. To build the transfer, our server reads your wallet address's USDC balance on the public Sui network.</p>
        </div>
        <p class="text-xs text-sand-300/80">Or send it yourself, to this Sui address:</p>
        <p class="flex items-start gap-2"><code id="co-payto" class="break-all text-xs text-ibad-300"></code> <button type="button" class="btn-ghost !min-h-8 shrink-0 !px-3 !py-1 co-copy" data-target="co-payto">Copy</button></p>
        <p class="text-xs text-sand-300/80">Pay before <span id="co-exp"></span>. Send from a Sui wallet in a single transfer; exchange withdrawals may batch or round, so use an exact-amount wallet transfer. Any other amount will not match. Keep this tab open, or note your order ID and token below.</p>
        <details class="text-xs text-sand-300/70"><summary class="cursor-pointer">Order token (private)</summary><code id="co-token" class="break-all"></code></details>
        <label class="mt-3 block text-sand-200/85" for="co-digest">Transaction digest</label>
        <input id="co-digest" class="mt-1 w-full rounded-lg border border-sand-200/20 bg-night-950 px-3 py-2 font-mono text-xs" placeholder="e.g. 9xQ…" autocomplete="off" spellcheck="false" />
        <div class="mt-3 flex flex-wrap gap-2">
          <button id="co-verify" type="button" class="btn-primary">Verify payment</button>
          <button id="co-auto" type="button" class="btn-ghost">Find my payment</button>
        </div>
      </div>
      <div id="co-done" hidden>
        <p class="text-lg text-sand-50">Payment confirmed.</p>
        <p class="mt-1 text-xs text-sand-300/70">All sales final, except where the law requires otherwise.</p>
        <p class="mt-2"><a id="co-dl" class="btn-primary" href="#" rel="nofollow noopener">Download</a></p>
        <p class="mt-2 text-xs text-sand-300/80"><span id="co-exp">The link is short-lived.</span> <strong class="text-sand-100">Weekly updates included:</strong> save your order ID <code id="co-oid" class="text-spice-300"></code> and token, and bookmark your <a id="co-redl" class="text-ibad-300" href="/store/download/" rel="nofollow">re-download page</a> (it holds only your order ID; you paste the token there). It always serves the latest version.</p>
      </div>
      <p id="co-msg" class="text-sm text-spice-300"></p>
    </div>
  </dialog>

<script>
  // Sales source (first touch per tab): utm_* and ?ref= from store pages, saved with the order. No cookies, no third parties.
  const SRC_KEY = 'sm-src';
  function readSource(): Record<string, string> | undefined {
    try { return JSON.parse(sessionStorage.getItem(SRC_KEY) || 'null') ?? undefined; } catch { return undefined; }
  }
  const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;
  const dlg = $('checkout') as HTMLDialogElement;
  const msg = (t: string) => ($('co-msg').textContent = t);
  let sku = '';
  let order: any = null;
  let polling = 0;
  const KEY = 'sm-store-order';
  const REASONS: Record<string, string> = {
    store_not_open: 'Checkout is not open yet. Thanks for looking!',
    store_misconfigured: 'Checkout is temporarily unavailable.',
    too_many_orders: 'Too many orders from this connection. Try again in an hour.',
    payment_not_found_yet: 'No matching payment yet. It can take a few seconds to appear.',
    transaction_not_found: 'Transaction not found yet (or it is on another network). Try again in a few seconds.',
    digest_already_used: 'That transaction was already used for an order.',
    order_window_closed: 'This order expired. If you paid, email us with your order ID and digest.',
    no_usdc_payment_to_store: 'That transaction did not send USDC to the store address.',
    invalid_digest_format: 'That does not look like a Sui transaction digest.',
  };
  const say = (r: any) => msg(REASONS[r.reason] ?? (r.reason ? `Not yet: ${r.reason}` : 'Something went wrong.'));
  async function api(path: string, body?: any) {
    const res = await fetch(path, body ? { method: 'POST', headers: { 'content-type': 'application/json' }, body: JSON.stringify(body) } : {});
    return res.json().catch(() => ({ ok: false, reason: 'network_error' }));
  }
  function showOrder(o: any) {
    order = o;
    sessionStorage.setItem(KEY, JSON.stringify({ orderId: o.orderId, token: o.token, sku: o.sku }));
    $('co-step1').hidden = true; $('co-step2').hidden = false; $('co-done').hidden = true;
    $('co-id').textContent = o.orderId; $('co-net').textContent = o.network === 'sui:mainnet' ? 'Sui mainnet (real USDC)' : `${o.network} (test network, no real money)`;
    $('co-amount').textContent = o.amount; $('co-payto').textContent = o.payTo;
    $('co-exp').textContent = new Date(o.expiresAt).toLocaleTimeString();
    $('co-token').textContent = o.token;
  }
  function done(r: any) {
    $('co-step1').hidden = true; $('co-step2').hidden = true; $('co-done').hidden = false;
    ($('co-dl') as HTMLAnchorElement).href = r.downloadUrl; msg('');
    const mins = Math.floor(Number(r.linkExpiresInSec) / 60);
    $('co-exp').textContent = mins > 0 ? `The link is short-lived (about ${mins} minutes).` : 'The link is short-lived.';
    if (order) { $('co-oid').textContent = order.orderId; ($('co-redl') as HTMLAnchorElement).href = `/store/download/?order=${encodeURIComponent(order.orderId)}`; /* S6: never the token in a URL; the buyer pastes it */ }
  }
  document.querySelectorAll<HTMLButtonElement>('.buy-btn').forEach((b) => b.addEventListener('click', () => {
    sku = b.dataset.sku!; $('co-title').textContent = b.dataset.name!;
    $('co-step1').hidden = false; $('co-step2').hidden = true; $('co-done').hidden = true; msg('');
    dlg.showModal();
  }));
  $('co-create').addEventListener('click', async () => {
    msg('Creating order…');
    const r = await api('/api/store/order', { sku, email: ($('co-email') as HTMLInputElement).value.trim() || undefined, src: readSource() });
    if (!r.ok) return say(r);
    msg(''); showOrder(r.order);
    const em = ($('co-email') as HTMLInputElement).value.trim();
    if (($('co-lessons-opt') as HTMLInputElement).checked && em) {
      const s = await fetch('/api/lessons/subscribe', { method: 'POST', headers: { 'content-type': 'application/json', authorization: `Bearer ${r.order.token}` }, body: JSON.stringify({ orderId: r.order.orderId, email: em, source: 'checkout' }) }).then((x) => x.json()).catch(() => ({ ok: false }));
      if (!s.ok) msg("Order created. We couldn't sign you up for Hwi's lessons; you can do it later on the re-download page.");
    }
  });
  // Hwi's lessons box shows only while signup is open (preview, or production after Hwi's review).
  // GL6: the on-hold sentence shows until the legal gate opens (privacy page live + terms line), then drops away.
  fetch('/api/lessons/subscribe').then((x) => x.json()).then((r) => { if (r && r.open) $('co-lessons').hidden = false; if (r && r.lessonsLive === true) $('co-lessons-hold').hidden = true; }).catch(() => {});
  ($('co-lessons-opt') as HTMLInputElement).addEventListener('change', (e) => {
    if ((e.target as HTMLInputElement).checked && !($('co-email') as HTMLInputElement).value.trim()) msg("Add your email above to get Hwi's lessons.");
  });
  async function verify(digest?: string) {
    if (!order) return;
    const r = await api('/api/store/verify', { orderId: order.orderId, token: order.token, digest });
    if (r.ok) { done(r); return true; }
    say(r); return !r.retryable;
  }
  $('co-verify').addEventListener('click', () => verify(($('co-digest') as HTMLInputElement).value.trim()));
  $('co-auto').addEventListener('click', async () => {
    if (polling) return;
    msg('Looking for your payment…');
    for (polling = 1; polling <= 20; polling++) { // at most 20 checks, 15 s apart
      if (await verify()) break;
      await new Promise((r) => setTimeout(r, 15000));
    }
    polling = 0;
  });
  // One-click pay (Wallet Standard): connect, ask our server for the exact-amount USDC transfer (built + dry-run there),
  // let the wallet sign and execute it, then submit the digest to the unchanged verifier. The manual flow stays as fallback.
  const wallets: any[] = [];
  const wreg = { register: (...ws: any[]) => { wallets.push(...ws); return () => {}; } };
  window.addEventListener('wallet-standard:register-wallet', (e: any) => { try { e.detail(wreg); } catch {} });
  window.dispatchEvent(new CustomEvent('wallet-standard:app-ready', { detail: wreg }));
  const PAY_REASONS: Record<string, string> = {
    not_enough_usdc: 'This wallet does not hold enough USDC on Sui for this order.',
    dry_run_failed: 'The transfer would fail (often: not enough SUI for gas). Top up a little SUI, or send manually below.',
    already_paid: 'This order is already paid.', order_window_closed: 'This order expired. Start a new one.',
  };
  $('co-wallet').addEventListener('click', async () => {
    if (!order) return;
    const w = wallets.find((x) => x.features?.['standard:connect'] && x.features?.['sui:signAndExecuteTransaction']);
    if (!w) return msg('No Sui wallet found in this browser. Install or unlock Slush (or another Sui wallet), or open this page in your wallet app. You can also send manually below.');
    try {
      msg(`Connecting ${w.name}…`);
      const { accounts } = await w.features['standard:connect'].connect();
      const chain = order.network;
      const account = accounts.find((a: any) => a.chains?.includes(chain)) ?? accounts[0];
      if (!account) return msg('The wallet shared no account.');
      msg('Building your exact transfer…');
      const res = await fetch('/api/store/pay-tx', { method: 'POST', headers: { 'content-type': 'application/json', authorization: `Bearer ${order.token}` }, body: JSON.stringify({ orderId: order.orderId, sender: account.address }) });
      const q = await res.json().catch(() => ({ ok: false, reason: 'network_error' }));
      if (!q.ok) return msg(PAY_REASONS[q.reason] ?? `Wallet payment unavailable (${q.reason}). You can send manually below.`);
      if (q.chain !== chain || String(q.payTo).toLowerCase() !== String(order.payTo).toLowerCase()) return msg('Payment details did not match the order. Please send manually below.');
      msg(`Approve the transfer of ${order.amount} USDC in ${w.name}…`);
      const tx = q.tx_json;
      const r = await w.features['sui:signAndExecuteTransaction'].signAndExecuteTransaction({ transaction: { toJSON: async () => tx }, account, chain });
      const digest = String(r?.digest ?? '').replace(/[^A-Za-z0-9]/g, '');
      if (!digest) return msg('The wallet did not return a transaction digest. Use "Find my payment" below.');
      ($('co-digest') as HTMLInputElement).value = digest;
      msg('Payment sent. Confirming…');
      for (let i = 0; i < 12; i++) { if (await verify(digest)) return; await new Promise((ok) => setTimeout(ok, 5000)); }
    } catch (e: any) { msg('Not paid: ' + String(e?.message ?? e).slice(0, 120) + '. You can try again or send manually below.'); }
  });
  document.querySelectorAll<HTMLButtonElement>('.co-copy').forEach((b) => b.addEventListener('click', async () => {
    try { await navigator.clipboard.writeText($(b.dataset.target!).textContent ?? ''); b.textContent = 'Copied'; } catch { b.textContent = 'Select'; }
    setTimeout(() => (b.textContent = 'Copy'), 1500);
  }));
  // Resume an order from this tab session (fresh link if already paid).
  const saved = sessionStorage.getItem(KEY);
  if (saved) {
    const s = JSON.parse(saved);
    fetch('/api/store/status', { method: 'POST', headers: { 'content-type': 'application/json', authorization: `Bearer ${s.token}` }, body: JSON.stringify({ orderId: s.orderId }) }).then((r) => r.json()).then((r) => {
      if (!r.ok) return sessionStorage.removeItem(KEY);
      order = { ...s };
      if (r.status === 'paid') { dlg.showModal(); done(r); }
    }).catch(() => {});
  }
</script>
